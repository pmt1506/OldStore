# Cong lang nghe
PORT=8080

# Thu muc luu du lieu (tai khoan da luu + thu vien IPA)
DATA_DIR=./data

# Neu dat, moi request phai kem header X-Access-Password dung gia tri nay.
# De trong = khong yeu cau mat khau (chi nen dung khi chay tren may ca nhan/localhost).
ACCESS_PASSWORD=

# Gioi han dung luong 1 file IPA duoc tai (MB). 0 = khong gioi han.
MAX_DOWNLOAD_MB=0
